# Copie este arquivo para ".env" (mesma pasta) e preencha com seus valores reais.
# NUNCA cole o token no chat — edite o arquivo .env diretamente.

# Ex.: https://seu-dominio.atlassian.net
JIRA_SITE_URL=

# E-mail da conta Atlassian usada para gerar o token
JIRA_EMAIL=

# Gerado em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Chave do projeto no Jira
JIRA_PROJECT_KEY=FIN
